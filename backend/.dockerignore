# Keep the build context clean. Without this, `COPY . .` bakes the developer's
# local database (real user rows and password hashes) and a host-platform
# virtualenv into the image.
.venv/
venv/
db.sqlite3
*.sqlite3
media/
staticfiles/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log
.env

# Key material the local installer leaves in this directory. Without these,
# `docker build` on a machine that has run ./install.sh bakes the developer's
# field-encryption ring and package-signing key into the image, and 0.9.5e
# started publishing that image to a public registry. The container generates
# and persists its own in the `secrets` volume; nothing here should travel.
.field-encryption-key
.package-signing-key
*.pem
*.key
