# ===========================================================================
# Conformiti configuration.
#
#   Local development  ->  cp .env.example .env   (SQLite, console email,
#                          DEBUG on; the installers generate a secret key)
#   Docker             ->  no .env needed at all. docker-compose.yml carries
#                          production-safe defaults; anything set here
#                          overrides them. `install.sh --docker` writes a
#                          Docker-tuned .env for you.
#
# Every key the application reads is listed here.
# ===========================================================================

# --- Django (LOCAL path) ---
# DJANGO_DEBUG and DJANGO_SECRET_KEY configure the LOCAL dev server only. The
# Docker stack ignores both by design and uses CONFORMITI_DEBUG /
# CONFORMITI_SECRET_KEY instead (see "Docker only" at the bottom), so a
# development .env can never put a container into DEBUG or hand it a dev
# signing key.
#
# A strong unique key is REQUIRED when DJANGO_DEBUG=false. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# or point DJANGO_SECRET_KEY_FILE at a writable path and one is generated and
# persisted there on first boot (the compose stack does this). Placeholder
# values are rejected outright.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# DJANGO_SECRET_KEY_FILE=/app/secrets/django_secret_key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
TIME_ZONE=UTC
# LOG_LEVEL=INFO

# Where the generated evidence tree lives (defaults to ./compliance-data).
# COMPLIANCE_TREE_ROOT=./compliance-data

# --- Control readiness scoring ---
# A control scores 0-100 across the signals an auditor asks about. Weights need
# not sum to 100; the score is normalised. Defaults shown.
# SCORE_W_IMPLEMENTATION=35
# SCORE_W_OWNER=10
# SCORE_W_EVIDENCE=20
# SCORE_W_FRESHNESS=20
# SCORE_W_TESTING=15
# Subtracted (not added) when open risks reference the control.
# SCORE_W_RISK_PENALTY=20
# Three strictly ascending lower bounds: at risk / nearly there / ready.
# READINESS_BANDS=40,70,90
# Evidence reviewed within this many days is fully fresh; this far past its
# review date it scores zero.
# READINESS_FRESH_DAYS=30
# Fallback retest interval for controls that do not set their own.
# CONTROL_TEST_INTERVAL_DAYS=365
# Where uploaded files are stored when USE_S3=false (defaults to backend/media).
# MEDIA_ROOT=/app/media
# Where the SQLite file lives when USE_POSTGRES=false (defaults to
# backend/db.sqlite3). The end-to-end suite sets this so a test run never
# touches a developer's working database.
# SQLITE_PATH=/app/data/db.sqlite3

# --- Serving uploaded evidence ---
# Evidence is read through GET /api/documents/<id>/download/, which checks
# folder permissions and writes an audit row. With MEDIA_INTERNAL on (the
# default whenever DJANGO_DEBUG is false) the API answers with an
# X-Accel-Redirect and nginx sends the bytes from a location marked `internal`,
# so the storage path is not directly fetchable. Turn it off only if no
# accelerator sits in front of Django, in which case Django streams the file.
# MEDIA_INTERNAL=true
# MEDIA_ACCEL_PREFIX=/protected-media/

# --- Evidence packages (the auditor workspace) ---
# How long a sealed package may be issued to an external auditor for. Checked on
# every request, so shortening it takes effect on live grants too.
# ATTESTATION_GRANT_DAYS=45
# ATTESTATION_GRANT_MAX_DAYS=180
# Sealing and exporting re-hash every pinned file, so they get their own limit.
# THROTTLE_PACKAGE_WORK=6/min

# --- Malware scanning for uploaded evidence ---
# Off unless you run the scanning profile:
#   docker compose --profile scanning up -d
# In the Docker stack set CONFORMITI_SCANNING (see "Docker only"), never
# CLAMAV_ENABLED -- this file is shared with the local dev server, where a
# `clamav` hostname does not resolve and every upload would 503.
# When scanning is ON it fails CLOSED: an upload is refused if the scanner
# cannot be reached, because "is evidence scanned?" must not depend on whether
# the daemon happened to answer.
# CLAMAV_ENABLED=false
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT=10
# CLAMAV_CONNECT_TIMEOUT=3
# Must stay at or below StreamMaxLength in docker/clamd.conf.
# CLAMAV_MAX_MB=40

# --- Field encryption (secrets at rest) ---
# The TOTP secret and the Jira API token are encrypted with AES-256-GCM. The
# key ring is comma-separated, NEWEST FIRST: the first key encrypts, every key
# decrypts, so a key can be rotated with no downtime
# (manage.py rotate_field_keys). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# DJANGO_FIELD_ENCRYPTION_KEY=
# Or point this at a file holding one key per line; it is created at mode 0600
# on first boot if absent. This is how the Docker stack gets a persistent key
# with no configuration.
# DJANGO_FIELD_ENCRYPTION_KEY_FILE=/app/secrets/django_field_encryption_key
#
# With neither set, the ring is derived from DJANGO_SECRET_KEY when that is a
# real value, and otherwise generated into backend/.field-encryption-key.
# BACK THE KEY UP with your database: without it, enrolled authenticators
# cannot be read (single-use backup codes still work, and an administrator can
# reset a user's MFA), and a stored Jira token must be re-entered.

# --- Security ---
# With DJANGO_DEBUG=false, TLS/cookie hardening turns on automatically. If the
# app is served over plain HTTP (e.g. on a LAN before TLS is terminated), set
# BEHIND_TLS=false; the individual settings can still be overridden.
# BEHIND_TLS=true
# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# Enable HSTS once you're fully on HTTPS.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=false
# Rate limits (per client). Set CACHE_URL to Redis so limits are shared
# across gunicorn workers/containers (compose does this automatically).
# How many reverse proxies sit in front of the API. DRF picks the client IP
# this many hops from the end of X-Forwarded-For; left unset it trusts the
# WHOLE header and every rate limit below can be bypassed by varying it.
# 1 = the shipped nginx. Set 0 if the API is exposed directly.
# NUM_PROXIES=1
# THROTTLE_LOGIN=8/min
# THROTTLE_ANON=30/min
# THROTTLE_MFA=10/min
# Refresh gets its own budget: in cookie mode every user's first request of the
# morning goes through it, and the login limit would reject them behind a NAT.
# THROTTLE_REFRESH=30/min
#
# How credentials travel:
#   cookie  the tokens as HttpOnly cookies script cannot read, with CSRF
#           protection on unsafe methods (the default since 0.6.1). Over https
#           the cookies carry the __Host- / __Secure- prefixes and the CSRF
#           cookie is __Host-csrftoken. Same-origin deployments only -- the
#           shipped nginx serves the SPA and the API together, which is the
#           topology this supports;
#   header  tokens in localStorage, sent as Authorization (the 0.2.x-0.6.0
#           behaviour).
# Switching signs everyone out once; both modes still accept a Bearer header,
# so API clients are unaffected.
# AUTH_TRANSPORT=cookie
# Cookie names are derived (see above); set these only to pin them.
# AUTH_COOKIE_ACCESS=
# AUTH_COOKIE_REFRESH=
# Defaults to BEHIND_TLS. Leave it alone unless you know why.
# AUTH_COOKIE_SECURE=true
# CACHE_URL=redis://redis:6379/2
# Token lifetimes. Refresh tokens rotate on every use and are revoked on sign-out.
# JWT_ACCESS_MINUTES=60
# JWT_REFRESH_DAYS=7
# Minimum password length (PCI DSS v4 asks for 12).
# PASSWORD_MIN_LENGTH=12
# Upload ceiling for evidence, versions, templates and minutes (nginx enforces
# the same number at the edge — change both).
# MAX_UPLOAD_MB=32

# --- Database (leave POSTGRES_DB unset to use SQLite locally) ---
# POSTGRES_DB=compliance
# POSTGRES_USER=compliance
# POSTGRES_PASSWORD=compliance
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
# POSTGRES_CONN_MAX_AGE=60

# --- First boot (Docker entrypoint) ---
# Seed the demo dataset (5 users with the published password DemoPass123!).
# Set to false for a real deployment, or run `manage.py remove_demo_data` later.
# SEED_DEMO_DATA=true
# Create an initial superuser on first boot if it doesn't exist.
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_PASSWORD=
# DJANGO_SUPERUSER_EMAIL=

# --- Email provider: console | smtp | mailbox | ses ---
EMAIL_PROVIDER=console
DEFAULT_FROM_EMAIL=compliance@example.com
COMPLIANCE_TEAM_EMAIL=grc-team@example.com
# Review reminders fire this many days before a document's next review date:
REVIEW_ALERT_LEAD_DAYS=30,14,7,1
# Local hour (0-23, in TIME_ZONE) at which the daily review scan runs.
# REVIEW_SCAN_HOUR=6

# --- Amazon SES (when EMAIL_PROVIDER=ses) ---
# Credentials come from the standard AWS chain (env vars, ~/.aws, or IAM role).
AWS_SES_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SES_CONFIGURATION_SET=

# --- SMTP (when EMAIL_PROVIDER=smtp) ---
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_TIMEOUT=30

# --- Standard mailbox account (when EMAIL_PROVIDER=mailbox) ---
# Uses a normal inbox: IMAP or POP3 connects to the mailbox (to verify the
# account and, for IMAP, file a copy of each reminder in Sent); SMTP sends the
# mail. IMAP/POP3 cannot send, so the SMTP endpoint is required. The SMTP host/
# username default to the mailbox host/username, so a single provider (e.g.
# Gmail with an app password) often only needs the four MAILBOX_ lines below.
# MAILBOX_PROTOCOL=imap                 # imap or pop3
# MAILBOX_HOST=imap.gmail.com
# MAILBOX_PORT=993                      # 993 IMAP SSL, 995 POP3 SSL
# MAILBOX_USERNAME=you@example.com
# MAILBOX_PASSWORD=your-app-password
# MAILBOX_USE_SSL=true
# MAILBOX_SAVE_SENT=true                # append sent reminders to Sent (IMAP only)
# MAILBOX_SENT_FOLDER=Sent
# MAILBOX_TIMEOUT=30
# SMTP side of the same account (optional; fills in from the values above):
# MAILBOX_SMTP_HOST=smtp.gmail.com
# MAILBOX_SMTP_PORT=587                 # 587 STARTTLS, 465 implicit SSL
# MAILBOX_SMTP_USERNAME=you@example.com
# MAILBOX_SMTP_PASSWORD=your-app-password
# MAILBOX_SMTP_USE_TLS=true             # STARTTLS on 587
# MAILBOX_SMTP_USE_SSL=false            # set true (and port 465) for implicit SSL

# --- S3 document storage (optional; default is local filesystem) ---
USE_S3=false
# AWS_STORAGE_BUCKET_NAME=my-compliance-docs
# AWS_REGION=us-east-1

# --- Celery / Redis (Docker path; the local path runs reminders on demand) ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Docker only ---
# Host port nginx listens on.
# CONFORMITI_PORT=8080
# The Docker stack's DEBUG flag. Defaults to false and is intentionally NOT
# DJANGO_DEBUG, so a local development .env can never put a container into
# DEBUG mode. Only set this true for a throwaway local container.
# CONFORMITI_DEBUG=false
# The Docker stack's signing key. Leave unset (recommended) and the container
# generates a strong one on first boot and persists it in the `secrets` volume.
# CONFORMITI_SECRET_KEY=
# The Docker stack's field-encryption ring. Same reasoning as the signing key:
# it is deliberately NOT DJANGO_FIELD_ENCRYPTION_KEY, so a development .env can
# never hand a container a development key. Leave unset (recommended) and the
# container generates one on first boot into the `secrets` volume — which you
# must include in your backups.
# CONFORMITI_FIELD_ENCRYPTION_KEY=
# Turn malware scanning on for the Docker stack. Start the daemon too:
#   docker compose --profile scanning up -d
# CONFORMITI_SCANNING=false

# --- Single sign-on (OpenID Connect) ---
# Leave OIDC_ISSUER unset and the login screen shows no SSO button. Configured
# here and nowhere else: a provider an administrator could set from the UI is
# a provider they could point at themselves. Register the app at your
# provider (Okta, Entra ID, Google Workspace, Keycloak, Authentik...) as a
# confidential web client with the callback below; the flow is authorization
# code + PKCE, ID tokens are verified against the provider's JWKS.
# OIDC_ISSUER=https://login.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid email profile
# Text on the button.
# OIDC_LABEL=Sign in with Okta
# Defaults to https://<host>/api/auth/oidc/callback/ from the request; pin it
# behind a proxy that rewrites Host.
# OIDC_REDIRECT_URI=
# Who may sign in through the provider (comma-separated email domains). Empty
# means any domain the provider vouches for -- fine for a single-tenant IdP,
# wrong for a public one like Google unless you restrict it.
# OIDC_ALLOWED_DOMAINS=example.com
# On first sign-in, a verified email that matches exactly one local account
# links it. Superuser and staff accounts are never linked this way; use
# `manage.py link_oidc_identity` for those, deliberately.
# OIDC_LINK_BY_EMAIL=true
# OIDC_REQUIRE_VERIFIED_EMAIL=true
# Create accounts for people the provider vouches for but who have no local
# account, with this role. Refused if the role can manage users.
# Which workspace an auto-provisioned single-sign-on account joins (0.9.0).
SSO_WORKSPACE=default
# OIDC_AUTO_PROVISION=false
# OIDC_DEFAULT_ROLE=Viewer

# --- Single sign-on (SAML 2.0) ---
# For providers that still insist on SAML. SP-initiated only: the login
# button sends an AuthnRequest (HTTP-Redirect binding) and the provider posts
# a signed Response to the ACS. The provider's signing certificate is the
# trust anchor -- paste the PEM (or point at a file); there is no metadata
# auto-fetch on purpose. Get the SP metadata to give the provider from
# https://<host>/api/auth/saml/metadata/ once configured.
# SAML_IDP_ENTITY_ID=https://idp.example.com/metadata
# SAML_IDP_SSO_URL=https://idp.example.com/sso/saml
# SAML_IDP_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# SAML_IDP_CERT_FILE=/app/secrets/idp.pem
# Defaults to https://<host>/api/auth/saml/metadata/ and .../acs/ from the request.
# SAML_SP_ENTITY_ID=
# SAML_ACS_URL=
# SAML_LABEL=Sign in with SAML
# Attribute carrying the email when the NameID is not an email address, e.g.
# http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress
# SAML_EMAIL_ATTRIBUTE=
# Linking and provisioning policy: same as the OIDC_* twins unless set.
# SAML_ALLOWED_DOMAINS=
# SAML_AUTO_PROVISION=false
# SAML_DEFAULT_ROLE=Viewer
# SAML_LINK_BY_EMAIL=true

# --- Step-up on single sign-on ---
# off | if_enrolled (default) | required. With if_enrolled, a person who has
# a local authenticator is asked for its code after an SSO sign-in in which
# the provider did not assert a second factor. With required, a sign-in with
# neither is refused. What counts as an asserted second factor is the list
# in SSO_MFA_ASSERTIONS (OIDC amr values, SAML AuthnContext classes).
# SSO_STEP_UP=if_enrolled
# SSO_MFA_ASSERTIONS=mfa,otp,hwk,urn:oasis:names:tc:SAML:2.0:ac:classes:TimeSyncToken

# --- Passkeys / security keys (WebAuthn) as a second factor ---
# On for everyone with no configuration: people enrol from Settings > Security.
# A passkey is bound for life to the relying-party id, which defaults to the
# host the request arrives on (without the port); the accepted origin defaults
# to the request's own. Pin both behind a proxy that rewrites Host (the Vite
# dev server does: use localhost / http://localhost:5173 there), or to keep
# serving keys enrolled under an earlier hostname. Browsers need https (or
# localhost) to use passkeys at all.
# WEBAUTHN_RP_ID=grc.example.com
# WEBAUTHN_ORIGINS=https://grc.example.com
# WEBAUTHN_RP_NAME=Conformiti
# preferred (default) | required | discouraged: whether the authenticator must
# verify the person (PIN, biometric) as well as their presence.
# WEBAUTHN_USER_VERIFICATION=preferred

# --- The questionnaire sent to the vendor ---
# The link a vendor receives is built from PUBLIC_URL, or from the origin the
# sending browser was on when it is unset (right behind the shipped nginx).
# PUBLIC_URL=https://grc.example.com
# Named in the vendor's email ("a security questionnaire from Acme Ltd").
# ORGANISATION_NAME=Acme Ltd
# Per-client rate on the public questionnaire endpoints.
# THROTTLE_QUESTIONNAIRE=20/min

# --- Package signing ---
# Every sealed manifest is signed (Ed25519, detached) with a key kept in a
# FILE, never in the database. Leave SIGNING_KEY_FILE alone and the key is
# generated at 0600 on first use (locally beside the database; in the Docker
# stack in the `secrets` volume -- back it up with it). Or supply the key
# itself as SIGNING_KEY (a PEM PKCS8 block, or a base64 32-byte seed).
# The public key and its fingerprint are published at /api/signing-keys/ and
# under Settings > About; give the fingerprint to your auditors out of band.
# Rotate with `manage.py rotate_signing_key`. SIGNING_ENABLED=false seals
# packages unsigned, as before 0.7.0.
# SIGNING_ENABLED=true
# SIGNING_KEY_FILE=/app/secrets/package_signing_key
# SIGNING_KEY=

# --- Slack / Microsoft Teams ---
# Incoming-webhook URLs (https only). Leave both unset and nothing is posted.
# Posted: package sealed/issued/withdrawn, auditor requests raised/returned,
# questionnaire returned, scanner down/up, file quarantined, daily summary.
# PUBLIC_URL (above) makes each post link back to the app.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxx
# TEAMS_WEBHOOK_URL=https://prod-00.westeurope.logic.azure.com/workflows/...
# Narrow what goes out (comma-separated event keys; default all):
# NOTIFY_EVENTS=package.sealed,package.issued,pbc.returned,scanner.down,digest.daily
# WEBHOOK_TIMEOUT=5
# Posts leave the request on a thread; true makes them synchronous (tests).
# WEBHOOK_SYNC=false
